{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "VIDEO",
      "bucket_name": "www-video"
    }
  ]
}
