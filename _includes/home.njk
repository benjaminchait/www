---
layout: default.njk
---
<header class="top">
  <h1>{{ site.title }}</h1>
</header>

<main>

{{ content | safe }}

<p class="actions">
  <a class="button" href="mailto:hello@benjaminchait.net">Say hi</a>
  <a class="button ghost" href="/archives">Read the writing</a>
</p>

<section class="section" aria-labelledby="communities">
  <h2 id="communities">Communities</h2>
  <p class="section-sub">Local events I’m proud of celebrating.</p>
  <div class="rows">
  {%- for c in home.communities %}
    <details>
      <summary><span class="row-title">{{ c.name }}</span> <span class="meta">{{ c.place }}</span></summary>
      <p><a href="{{ c.url }}">{{ c.url | replace("https://", "") }}</a>{% if c.post %} • <a href="{{ c.post }}">{{ c.postTitle }}</a>{% endif %}</p>
    </details>
  {%- endfor %}
  </div>
</section>

<section class="section" aria-labelledby="writing">
  <h2 id="writing">Writing</h2>
  <p class="section-sub">Recent posts, and everything since 2012.</p>
  <ul class="write-list">
    {%- set recentPosts = collections.posts | reverse %}
    {%- for post in recentPosts.slice(0, 6) %}
    <li><a class="post-link" href="{{ post.url | stripTrailingSlash }}">{{ post.data.title }}</a> <span class="meta">{% if post.data.location %}{{ post.data.location | placeName }} • {% endif %}{{ post.date | year }}</span></li>
    {%- endfor %}
  </ul>
  <p><a class="button ghost" href="/archives">All {{ collections.posts.length }} posts</a></p>
</section>

<section class="section" aria-labelledby="places">
  <h2 id="places">Places</h2>
  <p class="section-sub">My “favorite” spots, from places I’ve lived and visited.</p>
  <ul class="place-list">
    {%- for p in home.places %}
    <li><a href="{{ p.url }}"><span aria-hidden="true">{{ p.emoji }}</span> {{ p.name }}</a></li>
    {%- endfor %}
  </ul>
</section>

<section class="section" aria-labelledby="pups">
  <h2 id="pups">Pups</h2>
  <p class="section-sub">Good dogs, past and present.</p>
  <ul class="write-list">
    {%- for d in home.pups %}
    <li><a class="post-link" href="{{ d.url }}">{{ d.name }}</a> <span class="meta">{{ d.note }}</span></li>
    {%- endfor %}
  </ul>
</section>

</main>

<section class="hello" aria-labelledby="hello">
  <h2 id="hello">Say hello</h2>
  <p><a class="email" href="mailto:hello@benjaminchait.net">hello@benjaminchait.net</a></p>
  <p class="meta">Berkeley, California</p>
</section>

{% include "footer.njk" %}
