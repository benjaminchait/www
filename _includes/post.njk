---
layout: default.njk
---
<a class="muted small" href="/">{{ site.title }}</a>
<h1>{{ title }}</h1>
<p class="muted small">{{ page.date | dateFormat }}</p>
{{ content | safe }}

{% if map and mapkitToken %}
<div id="post-map" class="map-embed" aria-label="Map: {{ map.name }}"></div>
<script type="module">
  const setupMapKitJs = async () => {
    if (!window.mapkit || window.mapkit.loadedLibraries.length === 0) {
      await new Promise((resolve) => { window.initMapKit = resolve; });
      delete window.initMapKit;
    }
  };

  const main = async () => {
    await setupMapKitJs();
    const coordinate = new mapkit.Coordinate({{ map.lat }}, {{ map.lng }});
    const mapInstance = new mapkit.Map("post-map");
    mapInstance.region = new mapkit.CoordinateRegion(
      coordinate,
      new mapkit.CoordinateSpan({{ map.span | default(0.2) }}, {{ map.span | default(0.2) }})
    );
    const marker = new mapkit.MarkerAnnotation(coordinate, { title: {{ map.name | dump | safe }} });
    mapInstance.showItems([marker]);
  };

  main();
</script>
{% endif %}

<p class="not-muted small">
  {% set allPosts = collections.posts %}
  {% set currentIndex = -1 %}
  {% for post in allPosts %}
    {% if post.url == page.url %}
      {% set currentIndex = loop.index0 %}
    {% endif %}
  {% endfor %}
  {% if currentIndex > 0 %}
    {% set prevPost = allPosts[currentIndex - 1] %}
	<a class="not-muted" href="{{ prevPost.url | stripTrailingSlash }}">← {{ prevPost.data.title }}</a>
  {% endif %}
  {% if currentIndex > 0 and currentIndex < allPosts.length - 1 %} / {% endif %}
  {% if currentIndex >= 0 and currentIndex < allPosts.length - 1 %}
    {% set nextPost = allPosts[currentIndex + 1] %}
	<a class="not-muted" href="{{ nextPost.url | stripTrailingSlash }}">{{ nextPost.data.title }} →</a>
  {% endif %}
</p>

{% include "footer.njk" %}
